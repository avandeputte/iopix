[Unit]
Description=iopix
After=network.target

[Service]
Type=simple
User=@USER@
EnvironmentFile=@PREFIX@/app/config.env
WorkingDirectory=@PREFIX@/app
ExecStart="@PREFIX@/app/.venv/bin/python" -m app
Restart=always
RestartSec=5
# CPU-heavy background jobs run inside this process; keep it below interactive work
Nice=5

[Install]
WantedBy=multi-user.target
