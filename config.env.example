# ioPix settings. Copy this file to config.env in the app folder (setup.sh writes one for you) and fill it in.
# Variables already in the environment (a container's, a service's) win over this file. config.env holds passwords:
# keep it readable by the owner only (chmod 600), and never commit it. Every app of the suite reads the same names.

# --- iopix's own database: MariaDB / MySQL (settings, favorites, albums, AI results; the library without digiKam).
# Without it, the set-up page asks and writes data/viewer-db.json.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iopix
DB_USER=iopix
DB_PASSWORD=

# --- The Shared ioSuite database: accounts, sessions and suite-wide settings, shared by every app of the suite.
# Same server as DB_HOST / DB_PORT unless set.
# IOSUITE_DB_HOST=
# IOSUITE_DB_PORT=3306
IOSUITE_DB_NAME=iosuite
IOSUITE_DB_USER=iosuite
IOSUITE_DB_PASSWORD=

# --- Where people reach it
# The address people and the other apps reach iopix at (behind a reverse proxy). Empty: the address it is reached at.
# PUBLIC_URL=https://photo.example.com
# The domain the sign-in is shared on: signed in at one app under it, signed in at all of them. Empty: this host only.
# COOKIE_DOMAIN=example.com
# Where the server listens. Every app has its own default port, so all of them can run on one host.
# HOST=0.0.0.0
PORT=8600
# The addresses allowed to pass on the visitor's address (X-Forwarded-For): * (any), or your reverse proxy's.
# FORWARDED_ALLOW_IPS=*
# HTTPS served directly instead of behind a reverse proxy: both files.
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem

# --- Accounts
# The first admin, made on the first start when there is no account yet (or make it in the browser).
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# Sign-in at a reverse proxy (Cloudflare Access, Authelia...): also settable in Settings, suite-wide.
# AUTH_PROXY=cloudflare
# AUTH_PROXY_HEADER=
# AUTH_PROXY_TRUSTED=127.0.0.1,::1
# AUTH_PROXY_CREATE=
# CF_ACCESS_TEAM=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# --- Running it
# Time zone, e.g. Europe/Brussels.
# TZ=
# The server log shown at Maintenance › Updates and logs: DATA_DIR/iopix.log (LOG_FILE= with nothing after it: no file).
# LOG_FILE=
# UPDATE_CHECK=0 never asks GitHub whether a newer version exists.
# UPDATE_CHECK=1
# What update.sh and the version check follow.
# IOPIX_REPO=avandeputte/iopix
# IOPIX_BRANCH=main
# MCP=1 keeps the MCP server at /mcp on, whatever Settings says.
# MCP=1
# The account `python -m app.mcp` (stdio) acts as.
# MCP_USER=

# --- The library
PHOTOS_ROOT=/path/to/photos
# Everything iopix writes itself (index, thumbnails, models, backups); never inside the library.
# DATA_DIR=data
# digiKam's database: sqlite (digikam4.db in DIGIKAM_DB_DIR), mysql (DIGIKAM_DB_*), or none (no digiKam).
DIGIKAM_DB_TYPE=sqlite
DIGIKAM_DB_DIR=/path/to/digikamDB
# DIGIKAM_DB_HOST=127.0.0.1
# DIGIKAM_DB_PORT=3306
# DIGIKAM_DB_NAME=digikam
# DIGIKAM_DB_USER=digikam
# DIGIKAM_DB_PASSWORD=
# auto: a full copy before destructive operations; skip: never.
# DIGIKAM_DB_BACKUP=auto
# A command that writes a MySQL dump to stdout, instead of mysqldump.
# DIGIKAM_DB_DUMP=
# pgrep: check that digiKam is closed before writing its database; none: containers, digiKam on another machine.
# DIGIKAM_CHECK=pgrep

# --- What it may do
# READ_ONLY=1
# EDITING=1
# DB_WRITE=1
# SIDECAR_COMPAT=1

# --- AI features and background work
# Models fetched when missing at start, e.g. siglip2,yolox,geonames (setup.sh sets it).
# AUTO_MODELS=
HF_HUB_OFFLINE=1
# SEMANTIC=1
# ANALYSIS=1
# CAPTIONS=1
# BG_THREADS=
# PREWARM=1
# REINDEX_POLL=20
# GOOGLE_MAPS_API_KEY=
# GOOGLE_SERVER_KEY=
